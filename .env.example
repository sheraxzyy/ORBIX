# ORBIX Environment Template
# Safe to commit to version control. Replace placeholder values with your project secrets.

# =====================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed to the browser via Vite)
# =====================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# =====================================================================
# SERVER-SIDE & CI SECRETS (NEVER prefix with VITE_, NEVER expose to client)
# =====================================================================
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VAPID_PRIVATE_KEY=your-vapid-private-key
